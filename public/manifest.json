{
  "manifest_version": 3,
  "name": "HandFree",
  "version": "0.1.0",
  "description": "Accessible webpage interaction using head movement, with an in-page pointer only.",
  "action": {
    "default_title": "Open HandFree Control Center",
    "default_popup": "dashboard.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "mediapipe/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
